{
  "description": "Taskcraft Entry Hook registration (managed by tc init --agent codex)",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.taskcraft/hooks/entry.sh\"",
            "commandWindows": "node \"$(git rev-parse --show-toplevel)/.taskcraft/hooks/entry.mjs\""
          }
        ]
      }
    ]
  }
}
