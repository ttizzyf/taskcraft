{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taskcraft.local/schemas/lifecycle-definition-v1.json",
  "title": "Taskcraft lifecycle revision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "taskId",
    "revision",
    "reasonCode",
    "reason",
    "compilerVersion",
    "factsDigest",
    "policyDigest",
    "nodes",
    "edges"
  ],
  "properties": {
    "schemaVersion": {"const": "tc-lifecycle/v1"},
    "taskId": {"type": "string", "minLength": 1},
    "revision": {"type": "integer", "minimum": 1},
    "reasonCode": {
      "enum": [
        "initial",
        "replan_required",
        "scope_changed",
        "contract_changed",
        "level_changed",
        "manual_revision"
      ]
    },
    "reason": {"type": "string", "minLength": 1},
    "compilerVersion": {"type": "string", "minLength": 1},
    "factsDigest": {"type": "string", "minLength": 1},
    "policyDigest": {"type": "string", "minLength": 1},
    "changeSummary": {"type": "object"},
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/node"}
    },
    "edges": {
      "type": "array",
      "items": {"$ref": "#/$defs/edge"}
    }
  },
  "$defs": {
    "obligation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "duty", "title"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "duty": {"enum": ["required", "recommended", "optional"]},
        "title": {"type": "string", "minLength": 1},
        "evaluator": {"type": ["object", "null"]}
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "title",
        "objective",
        "procedureRef",
        "scope",
        "obligations"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {
          "enum": [
            "frame",
            "plan",
            "execute",
            "review",
            "integrate",
            "record"
          ]
        },
        "title": {"type": "string", "minLength": 1},
        "objective": {"type": "string", "minLength": 1},
        "procedureRef": {"type": "string", "minLength": 1},
        "scope": {"type": "object"},
        "actorConstraint": {"type": "object"},
        "entryGate": {"type": "object"},
        "exitGate": {"type": "object"},
        "retryPolicy": {"type": "object"},
        "inputSchema": {"type": "object"},
        "outputSchema": {"type": "object"},
        "obligations": {
          "type": "array",
          "items": {"$ref": "#/$defs/obligation"}
        }
      }
    },
    "edgeCondition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {
          "enum": [
            "always",
            "all_required_satisfied",
            "outcome_is",
            "finding_present",
            "manual"
          ]
        },
        "outcome": {
          "enum": [
            "success",
            "passed_with_fix",
            "changes_requested",
            "replan_required",
            "blocked",
            "failed",
            "abandoned",
            "unsupported"
          ]
        },
        "findingDisposition": {
          "enum": ["open", "resolved", "accepted"]
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {
        "from": {"type": "string", "minLength": 1},
        "to": {"type": "string", "minLength": 1},
        "condition": {"$ref": "#/$defs/edgeCondition"},
        "label": {"type": "string"}
      }
    }
  }
}
